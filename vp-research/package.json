{
  "name": "octogenie-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @octo/research-server",
    "dev:web": "npm run dev -w @octo/research-web",
    "build": "npm run typecheck && npm run build -w @octo/research-web",
    "start": "npm run build -w @octo/research-web && npm run start -w @octo/research-server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint apps packages e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
