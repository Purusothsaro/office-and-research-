# OctoGenie Research server. Copy to .env (or set in your service manager) and adjust.
# All data (accounts, sessions, projects, workspace versions, documents, audit log) is stored in MongoDB.

# MongoDB connection. Use a dedicated database for this app.
# Production: enable MongoDB authentication and TLS, e.g.
# MONGODB_URI=mongodb://octo_research:CHANGE_ME@db.internal:27017/?authSource=admin&tls=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=octogenie_research

# HTTP server (the web app in development runs on 1580 and forwards /api here).
PORT=3040
HOST=127.0.0.1

# Set to true whenever the app is served over HTTPS (always in production).
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
# Sign-in / registration attempts per IP per minute.
AUTH_RATE_LIMIT=10

# Built web app served by the API server (defaults to apps/web/dist).
# STATIC_DIR=

# Request logging (bodies, cookies and document contents are never logged).
LOG=true
