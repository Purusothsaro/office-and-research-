# OctoGenie Office server. Copy to .env (or set in your service manager) and adjust.
# All application data (accounts, sessions, files, revisions, drafts, audit log) is stored in MongoDB.

# MongoDB connection. Use a dedicated database for this app.
# Production: enable MongoDB authentication and TLS, e.g.
# MONGODB_URI=mongodb://octo_office:CHANGE_ME@db.internal:27017/?authSource=admin&tls=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=octogenie_office

# HTTP server
PORT=3030
HOST=127.0.0.1

# Set to true whenever the app is served over HTTPS (always in production).
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
# Sign-in / registration attempts per IP per minute.
AUTH_RATE_LIMIT=10

# Built web app served by the API server (defaults to apps/web/dist).
# STATIC_DIR=

# Request logging (bodies, cookies and file contents are never logged).
LOG=true
